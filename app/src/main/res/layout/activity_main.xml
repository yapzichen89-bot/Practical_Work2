<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- TODO: Add ImageView -->
    <ImageView
        android:id="@+id/imgEvent"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:scaleType="centerCrop"
        android:src="@drawable/event_image"
        android:contentDescription="Event Image" />

    <!-- TODO: Add TextViews for title, date, time, venue and description -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TECH INNOVATION DAY 2026"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/txtDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Date: 8 October 2026"
        android:textSize="16sp"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/txtTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Time: 9.00 AM - 4.00 PM"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/txtVenue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Venue: Politeknik Kuching Sarawak"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/txtDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Join us for a day of innovation, technology showcases and workshops."
        android:textSize="14sp"
        android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/btnRegister"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="REGISTER NOW" />

</LinearLayout>
